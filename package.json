{
  "name": "jobautomation",
  "version": "0.1.0",
  "private": true,
  "packageManager": "npm@11.8.0",
  "engines": {
    "node": ">=20.9.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "db:up": "docker compose -f compose.dev.yml up -d",
    "db:down": "docker compose -f compose.dev.yml down",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:studio": "prisma studio",
    "jobs:scan": "node scripts/jobs-worker.mjs 1",
    "jobs:worker": "node scripts/jobs-worker.mjs 15",
    "test": "node --import tsx --test tests/engine.test.ts tests/platform.test.ts"
  },
  "dependencies": {
    "@napi-rs/canvas": "^0.1.100",
    "@prisma/adapter-pg": "^7.10.1",
    "@prisma/client": "^7.10.1",
    "@react-pdf/renderer": "^4.9.0",
    "better-auth": "^1.7.14",
    "mammoth": "^1.13.0",
    "next": "16.3.6",
    "node-html-parser": "^9.0.5",
    "pdfjs-dist": "^5.6.205",
    "pg": "^8.23.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "server-only": "^0.0.1",
    "tesseract.js": "^7.0.0",
    "unpdf": "^1.7.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.0.0",
    "@types/node": "^24.0.0",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "dotenv": "^18.0.9",
    "eslint": "^9.0.0",
    "eslint-config-next": "16.3.6",
    "prisma": "^7.10.1",
    "tailwindcss": "^4.0.0",
    "tsx": "^4.23.15",
    "typescript": "^5.0.0"
  }
}
