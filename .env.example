# Local development only. Copy to .env and adjust if needed.
# Postgres runs from compose.dev.yml on port 5433 so it cannot clash with a
# locally installed Postgres on 5432.
DATABASE_URL="postgresql://jobautomation:jobautomation_dev@localhost:5433/jobautomation?schema=public"

# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
BETTER_AUTH_SECRET="replace-with-a-32-byte-random-hex-string"

# The origin the app is served from locally.
BETTER_AUTH_URL="http://localhost:3001"

# Optional. When set, resume extraction uses Google Gemini (resume text is sent
# to Google). Without it, extraction falls back to local text rules.
GEMINI_API_KEY=""
GEMINI_MODEL="gemini-3.5-flash-lite"
